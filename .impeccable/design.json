  "narrative": {
    "overview": "Avalon uses quiet dark surfaces, precise borders and a luminous GPU avatar. The implemented interface supports one selected model and session with readable conversation, explicit access controls and visible runtime state. This document captures the existing system.\n\nThe owner’s supplied wide_cinematic_poster_mockup_layout_of_a_desktop.png remains the ultimate luminous avatar reference. Phase 3 delivers four original shader bodies: cyan/gold Ethereal Human, violet Neon Sentinel with a tapered open cowl, recessed dark mask and angular armor, teal/gold Progre Mascot and purple orbital Abstract Core. Surface composition stays in .impeccable/surfaces/control-center.md and appearance.md.",
    "keyCharacteristics": [
      "Dark tonal surfaces and thin structural borders.",
      "Native Ubuntu typography and original vector stroke icons.",
      "Runtime-linked avatar motion with text equivalents and a selected-avatar still fallback."
    ],
    "rules": [
      {
        "name": "The Verified State Rule",
        "body": "Core state, connection label and controls follow the same runtime state; visual energy must not imply fabricated activity.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve visible cyan keyboard focus and explicit field labels.",
      "Do keep runtime status readable independently of the GPU preview.",
      "Do preserve truthful selected-model, capability and permission labels.",
      "Do reuse the native Ubuntu font stack and original local vectors."
    ],
    "donts": [
      "Don’t treat a static avatar capture as proof of live runtime activity.",
      "Don’t invent telemetry, activity or available device capabilities.",
      "Don’t add decorative glow to ordinary controls and containers.",
      "Don’t replace the owner-pinned visual authority with a new identity."
    ]
  }
}
